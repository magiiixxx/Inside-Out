# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> your project -> Connect
#
# The publishable key (sb_publishable_...) goes in
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Older projects call it the anon key.
#
# Add these SAME two variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key or any sb_secret_ key to this project.
# Both bypass Row Level Security and would let anyone with them read all
# your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: "Continue with Google" on the Log in and Sign up pages.
# Leave it unset (or "false") until the Google sign-in is set up (see docs/tickets/23-google-sign-up.md), then
# set it to "true" here AND in Vercel, and redeploy. Not a secret. The Google
# client secret goes in the Supabase dashboard, never in this project.
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Optional: require two-step verification (a code from an authenticator app)
# for the team page. Leave unset (or anything but "on") until EVERY admin has set
# it up at /review-desk/security and logged in with a code once. Then set it to
# "on" here AND in Vercel and redeploy. See docs/tickets/27-admin-two-step.md.
ADMIN_2FA=off

# Optional: the public address of the live site, used when sending people to
# Google and back. Not a secret, and not NEXT_PUBLIC_ (only the server uses
# it). If unset, the address the visitor used is taken instead.
SITE_URL=

# Optional: how people reach the BahayFind team. Shown on the Help and Privacy
# pages, and to an owner who has asked for a paid plan. Leave a line empty (or
# remove it) to show nothing. Set these in Vercel (Project, Settings,
# Environment Variables), then redeploy. They are not NEXT_PUBLIC_ and they are
# not secrets from the people who need them, but keeping them here instead of
# in the code keeps personal numbers out of the repository.
#   CONTACT_PHONE    a mobile number, for example 0917 123 4567
#   CONTACT_EMAIL    an email address
#   CONTACT_FACEBOOK the full address of your Facebook page, starting with https://
CONTACT_PHONE=09850589669
CONTACT_EMAIL=geve.ollosa.ui@phinmaed.com
CONTACT_FACEBOOK=https://www.facebook.com/grlynxm

# Optional: where owners send the payment for a paid plan. Shown only to an
# owner who has asked for a plan and chose that way to pay. Use a vertical bar
# between the parts, exactly in this order:
#   PAYMENT_GCASH=Account name | Mobile number
#   PAYMENT_MAYA=Account name | Mobile number
#   PAYMENT_BANK=Bank name | Account name | Account number
PAYMENT_GCASH=09850589669
PAYMENT_MAYA=09071278764
PAYMENT_BANK=
