# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> your project -> Connect
#
# The publishable key (sb_publishable_...) goes in
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Older projects call it the anon key.
#
# Add these SAME two variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key or any sb_secret_ key to this project.
# Both bypass Row Level Security and would let anyone with them read all
# your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: "Continue with Google" on the Log in and Sign up pages.
# Same idea as the Facebook switch below: leave it unset (or "false") until
# the Google sign-in is set up (see docs/tickets/23-google-sign-up.md), then
# set it to "true" here AND in Vercel, and redeploy. Not a secret. The Google
# client secret goes in the Supabase dashboard, never in this project.
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Optional: "Continue with Facebook" on the Log in and Sign up pages.
# Leave this unset (or "false") until the Facebook app and the Facebook
# provider in Supabase are set up (see docs/tickets/21-facebook-sign-up.md),
# then set it to "true" here AND in Vercel, and redeploy.
# It is not a secret: it only turns the button on. The Facebook app secret
# goes in the Supabase dashboard, never in this project.
NEXT_PUBLIC_FACEBOOK_LOGIN=false

# Optional: the public address of the live site, used when sending people to
# Facebook and back. Not a secret, and not NEXT_PUBLIC_ (only the server uses
# it). If unset, the address the visitor used is taken instead.
SITE_URL=
